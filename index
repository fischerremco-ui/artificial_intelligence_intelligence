<!doctype html>
<html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>AI / Intelligence Lab</title>
<style>
:root{--bg:#0a1018;--panel:#141f2c;--line:#344252;--ink:#eff3f6;--muted:#acbbca;--lime:#d6fa69;--orange:#ffb27d;--blue:#8fc4ff}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.6 system-ui,-apple-system,'Segoe UI',sans-serif}
button,input,select{font:inherit}
button{cursor:pointer;color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:7px;padding:11px 16px}
button:hover{border-color:var(--lime)}
button:disabled{opacity:.35;cursor:default}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
a{color:var(--lime)}
.primary{background:var(--lime);color:var(--bg);font-weight:750}
.top{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:16px 3vw;border-bottom:1px solid var(--line);flex-wrap:wrap}
.brand{font-weight:850;font-size:14px;letter-spacing:.13em;white-space:nowrap}
.accent{color:var(--lime)}
.toolbar,.actions{display:flex;flex-wrap:wrap;gap:8px}
.toolbar button{font-size:13px;padding:7px 10px}
.timer{font:700 16px ui-monospace,monospace;color:var(--lime);padding:8px}
.progress{height:3px;background:var(--line)}
.progress div{height:100%;background:var(--lime);width:0%;transition:width .2s}
.layout{max-width:1600px;margin:auto;display:grid;grid-template-columns:270px minmax(0,1fr);min-height:85vh}
aside{padding:24px 18px;border-right:1px solid var(--line)}
.badge,.eyebrow,.label{font:700 12px/1.5 ui-monospace,monospace;text-transform:uppercase;letter-spacing:.1em}
.badge{border:1px solid var(--line);color:var(--lime);border-radius:4px;padding:6px 9px}
.muted{color:var(--muted)}
.small{font-size:14px}
.blockhead{margin:18px 0 4px;padding:0 8px;font:800 11px ui-monospace,monospace;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;display:flex;justify-content:space-between;gap:8px}
.blockhead:first-child{margin-top:6px}
.nav{display:grid;gap:4px;margin:0 0 4px}
.nav button{display:flex;gap:12px;text-align:left;background:transparent;border-color:transparent;font-size:13px;padding:8px 10px}
.nav button[aria-current=step]{background:var(--panel);color:var(--lime);border-color:var(--line)}
.nav b{font-family:ui-monospace,monospace;color:var(--muted)}
.nav button[aria-current=step] b{color:var(--lime)}
.railnote{border-top:1px solid var(--line);padding-top:16px;margin-top:16px;color:var(--muted);font-size:13px}
main{min-width:0;padding:38px clamp(22px,4vw,62px)}
.slide{max-width:1080px}
.slide[hidden]{display:none}
.eyebrow{color:var(--muted);margin-bottom:14px}
.mode{display:inline-flex;align-items:center;gap:8px;font:800 12px/1 ui-monospace,monospace;text-transform:uppercase;letter-spacing:.07em;padding:9px 15px;border-radius:999px;margin:0 0 20px}
.mode.kijken{background:#182335;color:var(--blue);border:1px solid #2b3f5c}
.mode.samen{background:#213327;color:var(--lime);border:1px solid #3a5230}
.mode.doen{background:#33261a;color:var(--orange);border:1px solid #59402a}
.mode.pauze{background:#20242b;color:var(--muted);border:1px solid var(--line)}
h1,h2{font-family:'Arial Narrow',Impact,system-ui,sans-serif;line-height:1.03;font-weight:900;text-transform:uppercase;letter-spacing:-.035em;margin:0 0 22px}
h1{font-size:clamp(40px,5.2vw,76px)}
h2{font-size:clamp(32px,4.3vw,58px)}
h3{font-size:20px;line-height:1.3;margin:0 0 12px}
.lead{font-size:21px;max-width:800px;color:var(--muted);margin:0 0 24px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:24px 0}
.card{padding:24px;background:var(--panel);border:1px solid var(--line);border-radius:12px;min-width:0}
.card.solo{max-width:760px}
.paper{background:#eff2eb;color:#17242d}
.paper .label,.paper .muted{color:#4b606a}
.label{color:var(--muted);margin-bottom:12px}
.quote{font-size:24px;line-height:1.45}
.actions{margin:18px 0}
.feedback{margin-top:16px;padding:16px 20px;background:#213327;border-left:3px solid var(--lime)}
.feedback:empty{display:none}
.feedback strong{color:var(--lime)}
details{border-top:1px solid var(--line);margin-top:18px;padding-top:14px}
summary{cursor:pointer;font-weight:650}
.docent{display:none;background:#2a211b;border:1px dashed var(--orange);padding:18px 20px;border-radius:9px;color:#f3d5bf;font-size:15px;margin-top:30px}
.notes .docent{display:block}
.docent .dhead{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:10px;gap:10px}
.docent .dhead b{color:var(--orange);font:800 12px ui-monospace,monospace;text-transform:uppercase;letter-spacing:.08em}
.docent .dtime{font:700 13px ui-monospace,monospace;color:var(--orange);white-space:nowrap}
.docent dl{margin:0;display:grid;gap:9px}
.docent dt{font:700 11px ui-monospace,monospace;text-transform:uppercase;letter-spacing:.07em;color:#c99a6f;margin-bottom:2px}
.docent dd{margin:0}
.footer{display:flex;justify-content:space-between;align-items:center;gap:15px;border-top:1px solid var(--line);margin-top:32px;padding-top:20px}
.family{border:1px solid var(--line);border-radius:9px;background:#192839;padding:17px}
.family .family{margin-top:12px;background:#253a4b}
.family .family .family{background:#354a31}
.family p{font-size:15px;margin:7px 0}
.family b{display:block}
.chips{display:flex;gap:7px;flex-wrap:wrap;margin:20px 0}
.chip{padding:7px 13px;border:1px solid #789252;background:#25371f;border-radius:5px;font:19px ui-monospace,monospace}
.stat{display:flex;justify-content:space-between;font-size:14px}
.bar{height:12px;border-radius:8px;overflow:hidden;background:var(--line);margin:6px 0 17px}
.bar span{display:block;height:100%;background:var(--lime)}
.switches{display:flex;flex-wrap:wrap;gap:8px}
.switches [aria-pressed=true]{background:var(--lime);color:var(--bg)}
.flow{display:grid;gap:10px}
.flow div{padding:15px 18px;background:var(--panel);border-left:3px solid var(--lime)}
.claim{border-bottom:1px solid var(--line);padding-bottom:15px;margin-bottom:15px}
.claim label{display:block}
select{width:100%;min-width:0;color:var(--ink);background:var(--bg);border:1px solid #65788b;border-radius:6px;padding:10px;margin-top:9px}
.explain{font-size:14px;color:var(--lime);margin:8px 0 0}
.mini{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.mini div{border:1px solid var(--line);border-radius:7px;padding:15px}
.mini strong{display:block;color:var(--lime);font:700 26px ui-monospace,monospace}
.checks label{display:block;margin:15px 0}
.checks input{width:19px;height:19px;margin-right:9px;vertical-align:middle;accent-color:var(--lime)}
pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#070e15;padding:20px;border:1px solid var(--line);border-radius:8px;font:14px/1.7 ui-monospace,monospace}
li{margin:7px 0}
ul{padding-left:22px}
.present aside{display:none}
.present .layout{grid-template-columns:1fr;max-width:1450px}
.present .lead{font-size:24px}
.skip{position:absolute;top:-100px;left:10px;background:var(--lime);color:black;padding:10px}
.skip:focus{top:10px}
.paper .actions button{font-size:15px}
.paper #voteOut{font-size:15px}
.status{font-size:13px;color:var(--muted);padding:0 3vw 14px}
.steps{display:grid;gap:10px;margin:18px 0;padding:0;list-style:none;counter-reset:step}
.steps li{counter-increment:step;padding:14px 18px 14px 52px;background:var(--panel);border:1px solid var(--line);border-radius:9px;position:relative}
.steps li::before{content:counter(step);position:absolute;left:14px;top:12px;width:26px;height:26px;border-radius:50%;background:var(--lime);color:var(--bg);font:800 13px ui-monospace,monospace;display:flex;align-items:center;justify-content:center}
.endq{margin-top:20px;padding:16px 20px;background:#1c2a3c;border-left:3px solid var(--blue);border-radius:0 8px 8px 0}
.endq b{color:var(--blue);display:block;font:700 11px ui-monospace,monospace;text-transform:uppercase;letter-spacing:.07em;margin-bottom:6px}
.timeline{display:grid;gap:8px;margin:22px 0}
.timeline div{display:flex;align-items:center;gap:14px;padding:12px 16px;background:var(--panel);border:1px solid var(--line);border-radius:8px;font-size:15px}
.timeline span.t{font:700 13px ui-monospace,monospace;color:var(--lime);min-width:64px}
.timeline .pauzerow{opacity:.6;font-style:italic}
.copybar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:10px}
@media(max-width:850px){.layout{grid-template-columns:1fr}aside{border-right:0;border-bottom:1px solid var(--line);padding:10px 18px}.nav{display:none}.blockhead{display:none}aside>.badge,aside>p,.railnote{display:none}.top{flex-direction:column;align-items:flex-start;gap:12px}.grid{grid-template-columns:1fr}main{padding:26px 20px}.lead{font-size:19px}.footer{flex-wrap:wrap}.card{padding:20px}.quote{font-size:22px}.mini{grid-template-columns:1fr}}
@media print{body{background:white;color:black}.top,aside,.footer,.actions,.progress,.switches,.status{display:none}.layout{display:block}main{padding:0}.slide[hidden],.slide{display:block!important;break-after:page}.card,.family,.flow div,pre,.steps li,.timeline div{background:white;color:black;border-color:#888}.muted,.eyebrow,.accent,.label{color:#333}.docent{display:block;background:white;color:black;border-color:#888}.feedback{background:white;color:black}.feedback strong,.explain{color:black}.endq{background:white;border-color:#888}h1,h2{font-size:30px}a{color:black}.mode{border:1px solid #888;color:black!important;background:white!important}}
</style></head><body><a href="#main" class="skip">Naar de lesinhoud</a>
<header class="top">
<div class="brand">AI <span class="accent">/</span> INTELLIGENCE <span class="accent">LAB</span></div>
<div class="toolbar">
<span class="timer" id="timer" aria-label="Resterende oefentijd">00:00</span>
<button id="timerBtn">Start timer</button>
<button id="resetTimer">Herstel</button>
<button id="notesBtn" aria-pressed="false">Docentnotities</button>
<button id="presentBtn" aria-pressed="false">Presentatiestand</button>
<button id="printBtn">Print draaiboek</button>
<button id="saveBtn">Bewaar dit bestand</button>
</div>
</header>
<div class="progress" aria-hidden="true"><div id="progress"></div></div>
<div class="layout">
<aside>
<span class="badge">Volledig programma / v2</span>
<p class="muted small">Vier uur · <span id="totalSteps"></span> stappen</p>
<div class="nav" aria-label="Lesstappen" id="nav"></div>
<div class="railnote">Casus Lindeheide is fictief.<br><br>Alle experimenten en voorbeeldantwoorden werken zonder account. Waar iets echt is (nieuwsvoorbeelden), staat dat er expliciet bij.<br><br>Gebruik tijdens de bouwopdrachten uitsluitend de aangeleverde fictieve gegevens — nooit echte politie-informatie in een gratis AI-account.</div>
</aside>
<main id="main">
